# Environment variables for the FastAPI backend
# Copy this file to .env and adjust values as needed

# App
APP_ENV=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501

# File upload
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=./uploads

# Job queue
JOB_QUEUE_MAX_SIZE=100
JOB_WORKER_COUNT=2

# Model registry (optional)
# MODEL_REGISTRY_DIR=./model_registry

# External services (for future phases)
# DATABASE_URL=postgresql://user:pass@localhost:5432/forecasting
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=forecasting-models