{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demand-forecasting",
  "main": "worker/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "DemandForecastingContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMAND_FORECASTING_CONTAINER",
        "class_name": "DemandForecastingContainer"
      }
    ]
  },
  "exports": {
    "DemandForecastingContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
